# Paths to required dependencies for SimpleLink Low Power F3 SDKs

# SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR is the location of your CC13XX/CC26XX SDK.
SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR?=

# import settings from CC13XX/CC26XX SDK
include $(SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR)/imports.mak
