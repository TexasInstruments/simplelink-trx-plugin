        </file>
        <file path="../../source/ti/trx/rfconfig/BP_EM_CC1407P_SE/rcl_settings_general_purpose_gfsk.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="source/ti/trx/rfconfig/BP_EM_CC1407P_SE">
