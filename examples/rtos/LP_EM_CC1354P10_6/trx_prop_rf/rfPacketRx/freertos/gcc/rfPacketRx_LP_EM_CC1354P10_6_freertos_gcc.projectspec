        </file>
        <file path="../../source/ti/trx/rfconfig/BP_EM_CC1407P_SE/rcl_settings_2gfsk50kbps_lp.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="source/ti/trx/rfconfig/BP_EM_CC1407P_SE">
