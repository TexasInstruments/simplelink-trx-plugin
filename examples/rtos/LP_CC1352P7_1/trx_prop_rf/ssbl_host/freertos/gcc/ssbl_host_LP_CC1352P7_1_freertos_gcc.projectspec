<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex M.CC1352P7"
            />
        </when>
    </applicability>

    <project
        title="Secure Serial Bootloader Host"
        name="ssbl_host_LP_CC1352P7_1_freertos_gcc"
        configurations="Debug"
        toolChain="GNU"
        connection="TIXDS110_Connection.xml"
        device="Cortex M.CC1352P7"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="com.ti.SIMPLELINK_TRX_PLUGIN;com.ti.SIMPLELINK_CC13XX_CC26XX_SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -DTRAP_FAILURE
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source
            -I${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source
            -O3
            -D_REENT_SMALL
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/kernel/freertos
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source/ti/posix/gcc
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source/third_party/freertos/include
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source/third_party/freertos/portable/GCC/ARM_CM4F
            -mcpu=cortex-m4
            -march=armv7e-m
            -mthumb
            -std=c99
            -std=c++11
            -mfloat-abi=hard
            -mfpu=fpv4-sp-d16
            -ffunction-sections
            -fdata-sections
            -g
            -gstrict-dwarf
            -Wall
            -I${CG_TOOL_ROOT}/arm-none-eabi/include/newlib-nano
            -I${CG_TOOL_ROOT}/arm-none-eabi/include
        "
        linkerBuildOptions="
            -L${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source
            -L${PROJECT_BUILD_DIR}/syscfg
            -lti_utils_build_linker.cmd.genlibs
            -march=armv7e-m
            -mthumb
            -mfloat-abi=hard
            -mfpu=fpv4-sp-d16
            -nostartfiles
            -static
            -Wl,--gc-sections
            -L${CG_TOOL_ROOT}/arm-none-eabi/lib/thumb/v7e-m/hard
            -lgcc
            -lc
            -lm
            --specs=nano.specs
        "
        sysConfigBuildOptions="
            --product ${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/.metadata/product.json
            --product ${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler gcc
        "
        description="Secure Serial Bootloader Host">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl/bldrcmds.h" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl_host/ssbl_host_main.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl_host/ssbl_host.h" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl_host/ssbl_host.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl_host/example_customer_private.pem" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl_host/example_customer_public.pem" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl_host/README.md" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl_host/README.html" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../freertos/ssbl_host.syscfg" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source/ti/ssbl_host/main_freertos.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source/ti/boards/LP_CC1352P7_1/Board.html" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../freertos/gcc/cc13x2x7_cc26x2x7_freertos.lds" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>