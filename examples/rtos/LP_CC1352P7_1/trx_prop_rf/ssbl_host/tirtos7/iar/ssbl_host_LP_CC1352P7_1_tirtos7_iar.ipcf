<?xml version="1.0" encoding="UTF-8"?>
<!-- IAR Project Connection File -->

<iarProjectConnection version="1.2" name="Secure Serial Bootloader Host" oneShot="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="IarProjectConnection_1.2.xsd">

    <device>
        <name>CC1352P7</name>
    </device>

    <asmIncludePath>
        <path>$PROJ_DIR$</path>
    </asmIncludePath>

    <includePath>
        <path>$PROJ_DIR$</path>
        <path>$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/source</path>
        <path>$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source</path>
        <path>$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/kernel/tirtos7/packages</path>
        <path>$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/source/ti/posix/iar</path>
    </includePath>

    <defines>
        <define>TRAP_FAILURE</define>
    </defines>

    <extraOptions>
        <args>
            <arg>-f$PROJ_DIR$/ti_utils_build_compiler.opt</arg>
            <arg>--debug</arg>
            <arg>--silent</arg>
            <arg>-e</arg>
            <arg>--aeabi</arg>
            <arg>--thumb</arg>
            <arg>--diag_suppress=Pa050</arg>
        </args>
    </extraOptions>

    <linkerFile>
        <override>true</override>
        <path>$PROJ_DIR$/cc13x2x7_cc26x2x7_tirtos7.icf</path>
    </linkerFile>

    <linkerExtraOptions>
        <args>
            <arg>-L$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/source</arg>
            <arg>-L$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/kernel/tirtos7/packages</arg>
            <arg>-f$PROJ_DIR$/ti_utils_build_linker.cmd.genlibs</arg>
            <arg>--silent</arg>
        </args>
    </linkerExtraOptions>

    <customBuildTools>
        <customBuildTool atRoot="true" name="SysConfig"> <!-- Custom build tool for entire project-->
            <fileExtensions>.syscfg</fileExtensions>
            <command>$SYSCONFIG_ROOT$/sysconfig_cli.bat -o $PROJ_DIR$ -s "$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/.metadata/product.json" -s "$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/.metadata/product.json" --compiler iar $FILE_PATH$</command>
            <output>
                <path>SysConfig_Generated_Files.ipcf</path>
            </output>
            <hasPrio>true</hasPrio> <!-- true: run this tool before all other tools-->
        </customBuildTool>
    </customBuildTools>

    <heaps>
        <heap> <!-- If omitted, id="0" -->
            <size>0</size>
        </heap>
        <heap id="1">
            <size>0</size>
        </heap>
    </heaps>
    <stacks>
        <stack> <!-- If omitted, id="0" -->
            <size>512</size>
        </stack>
    </stacks>


    <files>
        <path reference="$PROJ_DIR$/bldrcmds.h">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl/bldrcmds.h</path>
        <path reference="$PROJ_DIR$/Board.html">$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/source/ti/boards/LP_CC1352P7_1/Board.html</path>
        <path copyTo="$PROJ_DIR$/cc13x2x7_cc26x2x7_tirtos7.icf">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/examples/rtos/LP_CC1352P7_1/trx_prop_rf/ssbl_host/tirtos7/iar/cc13x2x7_cc26x2x7_tirtos7.icf</path>
        <path reference="$PROJ_DIR$/example_customer_private.pem">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl_host/example_customer_private.pem</path>
        <path reference="$PROJ_DIR$/example_customer_public.pem">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl_host/example_customer_public.pem</path>
        <path reference="$PROJ_DIR$/main_tirtos.c">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl_host/main_tirtos.c</path>
        <path reference="$PROJ_DIR$/README.html">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl_host/README.html</path>
        <path reference="$PROJ_DIR$/README.md">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl_host/README.md</path>
        <path reference="$PROJ_DIR$/ssbl_host.c">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl_host/ssbl_host.c</path>
        <path reference="$PROJ_DIR$/ssbl_host.h">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl_host/ssbl_host.h</path>
        <path copyTo="$PROJ_DIR$/ssbl_host.syscfg">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/examples/rtos/LP_CC1352P7_1/trx_prop_rf/ssbl_host/tirtos7/ssbl_host.syscfg</path>
        <path reference="$PROJ_DIR$/ssbl_host_main.c">$SIMPLELINK_TRX_PLUGIN_INSTALL_DIR$/source/ti/ssbl_host/ssbl_host_main.c</path>
    </files>
</iarProjectConnection>