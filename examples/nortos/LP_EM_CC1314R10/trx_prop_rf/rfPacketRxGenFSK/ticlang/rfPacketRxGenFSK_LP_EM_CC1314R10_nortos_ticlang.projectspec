<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex M.CC1314R10"
            />
        </when>
    </applicability>

    <project
        title="RF Packet RX GEN FSK"
        name="rfPacketRxGenFSK_LP_EM_CC1314R10_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        cgtVersion="TICLANG_3.2.2.LTS"
        connection="TIXDS110_Connection.xml"
        device="Cortex M.CC1314R10"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="com.ti.SIMPLELINK_TRX_PLUGIN;com.ti.SIMPLELINK_CC13XX_CC26XX_SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -Dxti_log_Log_ENABLE
            -I${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source
            -DTRX_CC1407
            -DTRX_FEATURE_CC1407
            -Oz
            -flto
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/kernel/nortos
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/kernel/nortos/posix
            -mcpu=cortex-m33
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -Wall
        "
        linkerBuildOptions="
            -L${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/source
            -Wl,-lti/trx/host/lib/ticlang/m33f/trx_host.a
            -L${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source
            -L${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/kernel/nortos
            -L${PROJECT_BUILD_DIR}/syscfg
            -lti_utils_build_linker.cmd.genlibs
            -lti/devices/cc13x4_cc26x4/driverlib/bin/ticlang/driverlib.lib
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        postBuildStep="
            ${CG_TOOL_ROOT}/bin/tiarmobjcopy -O ihex  ${BuildArtifactFileName} ${BuildArtifactFileBaseName}.hex
        "
        sysConfigBuildOptions="
            --product ${COM_TI_SIMPLELINK_TRX_PLUGIN_INSTALL_DIR}/.metadata/product.json
            --product ${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        description="A receiver example on how to use the TRX Host Driver using Gen FSK PHY">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../rfPacketRxGenFSK.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../README.md" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source/ti/trx/rfconfig/BP_EM_CC1407P_SE/rcl_settings_wisun.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="source/ti/trx/rfconfig/BP_EM_CC1407P_SE">
        </file>
        <file path="../source/ti/trx/rfconfig/BP_EM_CC1407P_SE/rcl_settings_wisun.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="source/ti/trx/rfconfig/BP_EM_CC1407P_SE">
        </file>
        <file path="../source/ti/trx/rfconfig/BP_EM_CC1407P_SE/rcl_settings_2gfsk50kbps.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="source/ti/trx/rfconfig/BP_EM_CC1407P_SE">
        </file>
